# Profiles: one memory per API key instead of a single bundle. Takes precedence
# over BUNDLE_ROOT. Manage keys with `make profiles ARGS="create <name>"` (or the
# profiles CLI in the container).
#PROFILES_ROOT=/path/to/profiles

# Enables /admin: the settings page in the web UI (model and behaviour settings
# only — never the network and access settings in this file) and, in profile
# mode, profile management. A credential of its own, separate from AUTH_TOKEN.
#ADMIN_TOKEN=
# Where the settings page saves. Its values override this file and the
# environment; it holds API keys, so it is written readable by its owner only.
# Unset = settings can be viewed but not saved. `make` defaults it to
# .myzel-settings.json (gitignored); the Docker image to /config/settings.json.
#SETTINGS_FILE=/path/to/settings.json

# Path to the OKF bundle directory the agent manages (relative paths: from the
# repository root). Unset, the make targets use demo-bundle/ — a gitignored copy
# of sample-bundle/ — so agent runs don't modify the tracked sample.
#BUNDLE_ROOT=/path/to/my-memory

# Read-only demo: the bundle can be browsed, searched and queried, never changed.
# Drops the MCP write tools, the chat's write tools, /admin, dreaming and git
# autocommit. Needs BUNDLE_ROOT (profiles are refused). `make demo` and
# docker-compose.demo.yml set it for you.
#DEMO_MODE=true

# ── Primary model ──────────────────────────────────────────────────────
# Any OpenAI-compatible or Anthropic-compatible API endpoint.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_FORMAT=openai          # "openai" | "anthropic"
LLM_MODEL=                     # model id to request, e.g. "deepseek-chat" or "claude-sonnet-5"

# ── Fallback model (optional) ──────────────────────────────────────────
# Used when the primary model fails with a retryable error (timeout, 5xx).
# Leave LLM_FALLBACK_API_BASE_URL empty to disable fallback.
LLM_FALLBACK_API_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_API_FORMAT=openai
LLM_FALLBACK_MODEL=
# Which runs may use the fallback (query, mutate, chat; comma-separated).
# Unset = all of them. The compose files default this to "query".
# LLM_FALLBACK_ALLOW_FOR=query
# Also fail over on HTTP 429 (rate limited)? Off by default: a 429 usually means
# "slow down", and moving the load to a second (paid) model may not be wanted.
# LLM_FALLBACK_RETRY_429=false

# ── Legacy env vars (still work but deprecated) ─────────────────────────
# Prefer the LLM_API_* vars above. These are mapped automatically. With more
# than one of them set (or any but ANTHROPIC_API_KEY), LLM_PROVIDER says which
# one to use: anthropic | openrouter | llamacpp | deepseek | local.
# LLM_PROVIDER=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# LLAMACPP_BASE_URL=
# LLAMACPP_API_KEY=
# LOCAL_BASE_URL=
# LOCAL_API_KEY=

# Commit bundle changes to git after each mutation. A bundle that is not its own
# git repository yet is initialized at startup, and the server refuses to start
# when committing cannot work (no git, unsafe repo config). Commits are refused when the
# bundle's own .git/config sets keys that run programs (hooks, filters, …).
# Commit identity: your git config, or GIT_AUTHOR_NAME / GIT_AUTHOR_EMAIL /
# GIT_COMMITTER_NAME / GIT_COMMITTER_EMAIL (the Docker image sets defaults).
GIT_AUTOCOMMIT=false

PORT=3800

# Interface to bind. Defaults to loopback: the memory is only reachable from
# this machine. Set HOST=0.0.0.0 to expose it on the network — and set
# AUTH_TOKEN when you do. (The Docker image sets HOST=0.0.0.0 by itself, since
# a published container port requires it.)
#HOST=127.0.0.1

# Optional: require "Authorization: Bearer <token>" on /mcp and /api. Ignored
# in profile mode (PROFILES_ROOT), where each profile has its own key.
# Unset = open (fine for localhost). Set this before exposing Myzel anywhere.
#AUTH_TOKEN=

# Browser access control for /mcp and /api. Same-origin requests always pass;
# these add origins/hosts on top. Comma-separated; "*" disables the check.
# Needed only when a browser app on a DIFFERENT origin should reach the API.
#ALLOWED_ORIGINS=https://my-frontend.example
# Host header allowlist (DNS-rebinding guard). Loopback names always pass; on a
# public bind (HOST=0.0.0.0) IP addresses pass too. Any other hostname you use to
# reach the server (my-box.local, a reverse-proxy domain) must be listed here.
#ALLOWED_HOSTS=my-box.local

# docker compose only: host interface the container port is published on.
# Defaults to 127.0.0.1 (this machine only). Set 0.0.0.0 to expose it on the
# network — together with AUTH_TOKEN.
#MYZEL_BIND=127.0.0.1

# Requests per minute per client on /mcp and /api/chat — both can start an
# agent run, which costs tokens. 0 disables the brake.
#RATE_LIMIT=60
#RATE_LIMIT_WINDOW=1m
# The read-only browse API (/api/tree, /api/search, …) gets a looser brake of
# its own; each call reads the whole bundle. 0 disables it.
#RATE_LIMIT_BROWSE=600
# With AUTH_TOKEN, profile keys or ADMIN_TOKEN, 20 failed authentication attempts
# per 15 minutes lock a client out until the window ends (not configurable).
# Requests that carry no key at all are not counted.

# Behind a reverse proxy: which hop to trust for the client address, so rate
# limits apply per client instead of to the proxy. A hop count ("1"), or
# addresses/subnets ("loopback", "10.0.0.0/8"). Unset = no proxy.
#TRUST_PROXY=1

# Models a client may request per call (comma-separated, "*" for any). Unset
# means the server's own model is always used and a client-supplied override is
# refused, so a request cannot redirect spend onto a pricier model.
#ALLOWED_MODELS=

# Ceiling for one agent run, covering the whole tool loop. Prevents a stalled
# endpoint from pinning a request open forever. Generous by default: healthy
# runs on local hardware can take several minutes. Model requests add no
# transport timeout of their own, so this is the only ceiling on a slow reply.
#LLM_TIMEOUT=30m
#HOT_MEMORY_TIMEOUT=1m
#LLM_DISCOVERY_TIMEOUT=10s
# Tool-loop budget per run. Local models often need more turns than hosted ones.
# A run that uses every step is stopped and reported as unfinished (trace
# outcome "step-limit"), never as a success, and its answer is not cached.
#LLM_MAX_STEPS=12

# Query cache: repeated memory_query questions answer from cache until the
# bundle changes. QUERY_CACHE=false disables; QUERY_CACHE_TTL e.g. "1h" (default 24h).
#QUERY_CACHE=true
#QUERY_CACHE_TTL=24h

# Hot memory: recent writes + recent answers form a working set that queries
# check with one cheap tool-free LLM call before the full agent run.
#HOT_MEMORY=true
#HOT_MEMORY_TTL=1h
# The working set is shared by everyone using one bundle. Recent Q&A pairs are
# another caller's conversation — set this to false on a shared instance.
#HOT_MEMORY_RECALL_QA=true

# Dreaming: autonomous memory consolidation on an interval (opt-in).
# Deterministic signals (orphans, broken links, likely duplicates, oversized
# concepts, recent activity) decide if there's anything to do — a healthy
# memory costs nothing.
#DREAM_INTERVAL=6h
#DREAM_INSIGHTS=true
