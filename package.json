{
  "name": "understory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LLM-managed knowledge base following the OKF spec — MCP server + web UI",
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "agent:query": "pnpm --filter @understory/core agent:query",
    "agent:mutate": "pnpm --filter @understory/core agent:mutate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.34.6",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
