{
  "name": "@myzel/core",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./okf": "./dist/okf/index.js",
    "./agent": "./dist/agent/index.js",
    "./providers": "./dist/providers/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "pnpm run typecheck:test && vitest run",
    "agent:query": "tsx src/agent/cli.ts query",
    "agent:mutate": "tsx src/agent/cli.ts mutate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:coverage": "pnpm run typecheck:test && vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.94",
    "@ai-sdk/openai-compatible": "^3.0.82",
    "ai": "^7.0.160",
    "simple-git": "^4.0.2",
    "undici": "^8.12.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
