{
  "name": "@myzel/server",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "bin"
  ],
  "main": "./dist/index.js",
  "bin": {
    "myzel": "./bin/myzel"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "test": "pnpm run typecheck:test && vitest run --passWithNoTests",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@myzel/core": "workspace:*",
    "ai": "^7.0.138",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
