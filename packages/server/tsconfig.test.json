  // rootDir ".." because the tests share the scripted fake model with core
  // (../core/test/support). noEmit: nothing is written, so this has no output effect.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".."
  },
  "include": ["src", "test", "../core/test/support"]
}
